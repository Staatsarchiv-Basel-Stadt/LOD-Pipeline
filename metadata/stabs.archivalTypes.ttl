# Content Types (Archivalienart)
# ------------------------------
# Formalisiert die im StABS verwendeten Einträge <Archivalienart>

stabs-art: a owl:NamedIndividual, skos:ConceptScheme ;
	dcterms:creator <org/staatsarchiv> ;
    dcterms:title "Archivalienart"@de, "Archival Type"@en ;
	skos:definition "Vokabular der im Staatsarchiv Basel-Stadt verwendeten Archivalienarten"@de ;
    rdfs:label "Archivalienart"@de, "Archival Type"@en ;
    skos:hasTopConcept stabs-art:10001, stabs-art:10002, stabs-art:10003, stabs-art:10004, stabs-art:10005, stabs-art:10006, stabs-art:10007, stabs-art:10099, stabs-art:10101, stabs-art:10188, stabs-art:13152, stabs-art:13161, stabs-art:13162
    .

stabs-art:10001 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Akte"@de ;
    .

stabs-art:10002 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Urkunde"@de ;
    .

stabs-art:10003 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Bild"@de ;
    .

stabs-art:10004 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Plan"@de ;
    .

stabs-art:10005 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Bewegtbild (Film)"@de ;
    .

stabs-art:10006 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Tonaufzeichnung"@de ;
    .

stabs-art:10007 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Drucksache"@de ;
    .

stabs-art:10099 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Mikroform"@de ;
    .

stabs-art:10101 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Objekt"@de ;
    skos:altLabel "Gegenstand"@de ;
    skos:definition "Wird für dreidimensionale Objekte verwendet. Wurde vom 13.7.2001 bis 15.4.2015 als \"Gegenstand\" bezeichnet."@de ;
    .

stabs-art:10188 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Digitales Speichermedium"@de ;
    skos:definition "Wird verwendet für Angabe aller Arten von Trägern digital gespeicherter Informationen."@de ;
    .

stabs-art:13152 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Plakat"@de ;
    skos:definition "Zur Beschreibung grossformatiger Drucke (Text und Bild) auf Papier, die in der Öffentlichkeit angebracht werden."@de ;
    skos:exactMatch gnd:4046198-1, wd:Q429785 ;
    skos:closeMatch aat:300027221  # Getty AAT für posters
    .

stabs-art:13161 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Datei"@de ;
    skos:definition "Eine Menge elektronischer Daten, die dauerhaft und in einer bestimmten Form (Dateiformat) gespeichert sind."@de ;
    .

stabs-art:13162 a rico:Type, skos:Concept ;
    skos:inScheme stabs-art: ;
    skos:prefLabel "Netzressource"@de ;
    skos:definition "Generischer Begriff für Website, Online-Ressourcen etc."@de ;
    .