PREFIX stabs-tht: <https://ld.bs.ch/RiC/vocabularies/thesaurusTypes/>

# Content Types (Archivalienart)
# ------------------------------
# Formalisiert die im StABS verwendeten Einträge <Archivalienart> als contentTypes

stabs-cnt: a owl:NamedIndividual, skos:ConceptScheme ;
	dcterms:creator <org/staatsarchiv> ;
	dcterms:title "Vokabular der im Staatsarchiv Basel-Stadt verwendeten Archivalienarten"@de ;
	rdfs:label "Archivalienart"@de ;
	skos:definition "Vokabular der im Staatsarchiv Basel-Stadt verwendeten Archivalienarten"@de ;
	skos:hasTopConcept stabs-cnt:Mikroform, stabs-cnt:Objekt, stabs-cnt:Akte, stabs-cnt:Urkunde, stabs-cnt:Plan, stabs-cnt:Bewegtbild-Film, stabs-cnt:Tonaufzeichnung, stabs-cnt:Drucksache, stabs-cnt:Digitales-Speichermedium, stabs-cnt:Plakat, stabs-cnt:Datei, stabs-cnt:Netzressource
	.

stabs-cnt:Mikroform a rico:ContentType, skos:Concept, owl:NamedIndividual ;
    rdfs:label "Mikroform"@de ;
 	skos:prefLabel "Mikroform"@de ;
 	skos:topConceptOf stabs-cnt:
 	.

